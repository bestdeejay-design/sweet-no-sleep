    "%@ uses temporary system power assertions and releases them when work ends.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uses temporary system power assertions and releases them when work ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ usa bloqueos temporales de energía del sistema y los libera al terminar el trabajo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は一時的なシステム電源アサーションを使い、作業が終わると解放します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 임시 시스템 전원 어서션을 사용하고, 작업이 끝나면 해제해요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ использует временные системные блокировки питания и снимает их, когда работа заканчивается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会使用临时的系统电源断言，并在工作结束时释放。"
          }
        }
      }
    },
