    "During an awake session, %@ gently suggests looking away from code and into the distance for about 20 seconds.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "During an awake session, %@ gently suggests looking away from code and into the distance for about 20 seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante una sesión activa, %@ sugiere suavemente apartar la vista del código y mirar a lo lejos durante unos 20 segundos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起きている間のセッションでは、%@がコードから目を離し、遠くを約20秒見るよう優しく提案します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨어 있는 세션 중 %@의 안내: 코드에서 눈을 떼고 약 20초 동안 먼 곳을 바라보세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время активной сессии %@ мягко предлагает около 20 секунд смотреть от кода вдаль."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清醒会话期间，%@ 会温和地建议你把目光从代码移开，望向远处约 20 秒。"
          }
        }
      }
    },
