            "value": "Concentración sin suspensiones inesperadas"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予期しないスリープなしで集中"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예기치 않은 절전 없이 집중"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фокус без неожиданного сна"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专注时不意外睡眠"
          }
        }
      }
    },
    "From the repository root: ./Scripts/agent-session.sh my-agent-1 -- ./run-agent.sh\nFor IDE hooks: agent-event.sh start > heartbeat (about once a minute) > waiting when a question needs you > done or failed; use one ID per session.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the repository root: ./Scripts/agent-session.sh my-agent-1 -- ./run-agent.sh\nFor IDE hooks: agent-event.sh start > heartbeat (about once a minute) > waiting when a question needs you > done or failed; use one ID per session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde la raíz del repositorio: ./Scripts/agent-session.sh my-agent-1 -- ./run-agent.sh\nPara hooks de IDE: agent-event.sh start > heartbeat (aprox. una vez por minuto) > waiting cuando una pregunta necesite tu respuesta > done o failed; usa un ID por sesión."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リポジトリのルートで: ./Scripts/agent-session.sh my-agent-1 -- ./run-agent.sh\nIDEフック: agent-event.sh start > heartbeat（約1分ごと）> 質問への回答が必要なとき waiting > done または failed。セッションごとに ID を1つ使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소 루트에서: ./Scripts/agent-session.sh my-agent-1 -- ./run-agent.sh\nIDE 훅: agent-event.sh start > heartbeat (약 1분마다) > 질문에 답이 필요하면 waiting > done 또는 failed; 세션마다 ID 하나를 사용하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из корня репозитория: ./Scripts/agent-session.sh my-agent-1 -- ./run-agent.sh\nДля IDE-хуков: agent-event.sh start > heartbeat (примерно раз в минуту) > waiting, когда нужен твой ответ > done или failed; используй один ID на сессию."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在仓库根目录中运行：./Scripts/agent-session.sh my-agent-1 -- ./run-agent.sh\nIDE 钩子：agent-event.sh start > heartbeat（约每分钟一次）> 需要你回答时 waiting > done 或 failed；每个会话使用一个 ID。"
          }
        }
      }
    },
