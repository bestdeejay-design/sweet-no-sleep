    "Loopback-only HTTP listener on 127.0.0.1:18290 for sandboxed runners that cannot open URL schemes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopback-only HTTP listener on 127.0.0.1:18290 for sandboxed runners that cannot open URL schemes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escucha HTTP solo de loopback en 127.0.0.1:18290 para ejecutores en sandbox que no pueden abrir esquemas de URL."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "127.0.0.1:18290 でのみ受け付ける HTTP リスナーです。URL スキームを開けないサンドボックス内のランナー向けです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "127.0.0.1:18290에서만 응답하는 HTTP 리스너로, URL 스킴을 열 수 없는 샌드박스 실행기용이에요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP-слушатель только для loopback на 127.0.0.1:18290 для изолированных запускателей, которые не могут открывать URL-схемы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限回环的 HTTP 监听器，位于 127.0.0.1:18290，供无法打开 URL 方案的沙盒运行器使用。"
          }
        }
      }
    },
