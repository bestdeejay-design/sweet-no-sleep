      }
    },
    "Live status of power assertions, battery polling, and kernel timers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live status of power assertions, battery polling, and kernel timers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado en vivo de los bloqueos de energía, el sondeo de batería y los temporizadores del kernel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電源アサーション、バッテリーのポーリング、カーネルタイマーのリアルタイム状態。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전원 어서션, 배터리 폴링, 커널 타이머의 실시간 상태."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущее состояние блокировок питания, опроса батареи и таймеров ядра."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电源断言、电池轮询和内核计时器的实时状态。"
          }
        }
      }
    },
    "Local hooks can tell %@ when work starts, send heartbeats, report completion, or ask for your approval.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local hooks can tell %@ when work starts, send heartbeats, report completion, or ask for your approval."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los hooks locales pueden avisar a %@ cuando empieza el trabajo, enviar heartbeats, informar de la finalización o pedir tu aprobación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルフックは、作業の開始を%@に伝えたり、heartbeat を送ったり、完了を報告したり、承認を求めたりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 훅은 작업이 시작될 때 %@에게 알리고, heartbeat를 보내며, 완료를 보고하거나 승인을 요청할 수 있어요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальные хуки могут сообщить %@, что работа началась, отправлять heartbeat, сообщать о завершении или запрашивать твоё подтверждение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地钩子可以在工作开始时告诉 %@，发送心跳（heartbeat），报告完成，或请求你的确认。"
          }
        }
      }
    },
