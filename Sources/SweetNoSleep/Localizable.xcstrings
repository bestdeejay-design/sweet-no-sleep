        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras esta sesión, tu Mac se suspenderá de inmediato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッション終了後、Macはすぐにスリープします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 세션이 끝나면 Mac이 즉시 잠들어요"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
