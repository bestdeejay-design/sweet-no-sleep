          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の見た目と、作業中にペットがどれくらい目立つかを選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 모습과, 펫이 업무 시간에 얼마나 눈에 띄게 함께할지 고르세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери внешность %@ и насколько заметно питомец будет участвовать в твоём рабочем дне."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 %@ 的外观，以及宠物在你工作时的显眼程度。"
          }
        }
      }
    },
    "Choose a look. New skins install separately and do not require source-code changes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a look. New skins install separately and do not require source-code changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un aspecto. Los nuevos skins se instalan por separado y no requieren cambios en el código fuente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見た目を選んでください。新しいスキンは個別にインストールでき、ソースコードの変更は不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모습을 고르세요. 새 스킨은 따로 설치하며 소스 코드 변경이 필요 없어요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери внешний вид. Новые скины устанавливаются отдельно и не требуют изменений в исходном коде."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一种外观。新皮肤单独安装，无需修改源代码。"
          }
        }
      }
    },
    "Click to say hello, or drag the pet to move it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click to say hello, or drag the pet to move it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic para saludar o arrastra a la mascota para moverla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックであいさつ、ドラッグでペットを移動できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭하면 인사하고, 펫을 끌어서 옮길 수 있어요."
          }
        },
        "ru": {
          "stringUnit": {
