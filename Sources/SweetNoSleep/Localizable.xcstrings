          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードから少し目を離しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠깐 코드에서 눈을 떼 볼까요?"
