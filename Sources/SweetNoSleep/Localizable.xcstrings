          }
        }
      }
    },
    "User folder: ~/Library/Application Support/SweetNoSleep/PetSkins - place one skin.json in each skin folder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "User folder: ~/Library/Application Support/SweetNoSleep/PetSkins - place one skin.json in each skin folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carpeta del usuario: ~/Library/Application Support/SweetNoSleep/PetSkins - coloca un skin.json en cada carpeta de skin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーフォルダ: ~/Library/Application Support/SweetNoSleep/PetSkins - 各スキンのフォルダに skin.json を1つ置いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 폴더: ~/Library/Application Support/SweetNoSleep/PetSkins - 각 스킨 폴더에 skin.json 하나를 넣으세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка пользователя: ~/Library/Application Support/SweetNoSleep/PetSkins — помести один skin.json в каждую папку скина."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户文件夹：~/Library/Application Support/SweetNoSleep/PetSkins - 每个皮肤文件夹中放一个 skin.json。"
          }
        }
      }
    },
    "Uses monotonic system uptime; pauses while the Mac is asleep.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses monotonic system uptime; pauses while the Mac is asleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el tiempo de actividad monótono del sistema; se pausa mientras el Mac está suspendido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単調増加するシステム稼働時間を使用し、Macがスリープ中は一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단조 증가하는 시스템 가동 시간을 사용하며, Mac이 잠든 동안에는 멈춰요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует монотонное системное время работы; приостанавливается, пока Mac спит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用单调递增的系统运行时间；Mac 睡眠时暂停。"
          }
        }
      }
    },
