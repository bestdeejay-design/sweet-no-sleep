    "When this is off, the display may turn off while the Mac stays awake for work. This saves battery.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When this is off, the display may turn off while the Mac stays awake for work. This saves battery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está desactivado, la pantalla puede apagarse mientras el Mac sigue activo para el trabajo. Así se ahorra batería."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、Macは作業のために起きたままでもディスプレイが消えることがあります。バッテリーの節約になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 옵션을 끄면 Mac은 작업을 위해 깨어 있으면서도 디스플레이는 꺼질 수 있어요. 배터리를 아낄 수 있어요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда выключено, дисплей может гаснуть, пока Mac продолжает работать. Так экономится батарея."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭此项时，Mac 仍会为工作保持唤醒，但显示器可能会关闭。这样可以节省电池。"
          }
        }
      }
    },
    "Working": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working"
          }
        },
        "es": {
          "stringUnit": {
