    "We recommend the safer option: let macOS follow its normal sleep settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We recommend the safer option: let macOS follow its normal sleep settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomendamos la opción más segura: deja que macOS siga sus ajustes normales de suspensión."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より安全な方法をおすすめします: macOSの通常のスリープ設定に従わせてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 안전한 옵션을 권장해요: macOS의 일반 절전 설정을 따르게 하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекомендуем более безопасный вариант: пусть macOS следует обычным настройкам сна."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们推荐更安全的选项：让 macOS 遵循其正常的睡眠设置。"
          }
        }
      }
    },
