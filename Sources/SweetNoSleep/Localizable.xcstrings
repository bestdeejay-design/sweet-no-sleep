    "Automatically release assertions after continuous awake time to prevent battery drain from forgotten sessions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically release assertions after continuous awake time to prevent battery drain from forgotten sessions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera automáticamente los bloqueos tras un tiempo continuo activo para evitar que las sesiones olvidadas gasten la batería."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連続して起きている時間が経過すると自動でアサーションを解除し、消し忘れたセッションでバッテリーが減るのを防ぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속 깨어 있는 시간이 지나면 어서션을 자동으로 해제해서, 잊어버린 세션이 배터리를 소모하지 않게 해요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически снимать блокировки после непрерывного времени бодрствования, чтобы забытые сессии не разряжали батарею."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在持续清醒时间达到上限后自动释放电源断言，避免忘记关闭的会话耗尽电池。"
          }
        }
      }
    },
