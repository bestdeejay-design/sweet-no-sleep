    "%@ - other sessions are still protected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ - other sessions are still protected"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ - las demás sesiones siguen protegidas"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ - 他のセッションは引き続き保護されています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ - 다른 세션은 여전히 보호되고 있어요"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — остальные сессии всё ещё под защитой"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ - 其他会话仍受保护"
          }
        }
      }
    },
    "%@ - your Mac is back to its normal sleep settings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ - your Mac is back to its normal sleep settings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ - tu Mac ha vuelto a sus ajustes normales de suspensión"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ - Macは通常のスリープ設定に戻りました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ - Mac이 원래 절전 설정으로 돌아갔어요"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — твой Mac вернулся к обычным настройкам сна"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ - 你的 Mac 已恢复正常的睡眠设置"
          }
        }
      }
    },
    "%@ is keeping your Mac awake": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is keeping your Mac awake"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mantiene tu Mac despierto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@がMacをスリープさせずにいます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 덕분에 Mac이 깨어 있어요"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не даёт твоему Mac заснуть"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 让你的 Mac 保持唤醒"
          }
        }
      }
    },
    "%@ is on duty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is on duty"
          }
        },
        "es": {
