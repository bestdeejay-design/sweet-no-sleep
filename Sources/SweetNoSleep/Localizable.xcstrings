    "The AI agent connection was lost - sleep protection ended after timeout": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI agent connection was lost - sleep protection ended after timeout"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perdió la conexión con el agente de IA - la protección contra suspensión terminó tras el tiempo límite"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIエージェントとの接続が切れ、タイムアウト後にスリープ防止が終了しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 에이전트 연결이 끊어져 시간 초과 후 절전 방지가 종료됐어요"
          }
        },
        "ru": {
