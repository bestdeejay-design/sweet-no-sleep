          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 중"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работает"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作中"
          }
        }
      }
    },
    "You will be asked to confirm each session. Immediate sleep can interrupt other apps and agents.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will be asked to confirm each session. Immediate sleep can interrupt other apps and agents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se te pedirá confirmar cada sesión. La suspensión inmediata puede interrumpir otras apps y agentes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションごとに確認を求めます。即時スリープは他のアプリやエージェントを中断させることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션마다 확인을 요청해요. 즉시 절전은 다른 앱과 에이전트를 중단시킬 수 있어요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждую сессию придётся подтверждать. Немедленный сон может прервать работу других приложений и агентов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次会话都会要求你确认。立即睡眠可能会中断其他应用和智能体。"
          }
        }
      }
    },
    "Your approval is needed (y/n).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your approval is needed (y/n)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita tu aprobación (y/n)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの承認が必要です (y/n)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인이 필요해요 (y/n)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно твоё подтверждение (y/n)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要你确认 (y/n)。"
          }
        }
      }
    },
    "Your break reminder is ready. It is a suggestion, not a work blocker.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your break reminder is ready. It is a suggestion, not a work blocker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu recordatorio de pausa está listo. Es una sugerencia, no un obstáculo para el trabajo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "休憩のリマインダーの準備ができました。これは提案であり、作業を妨げるものではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴식 알림이 준비됐어요. 제안일 뿐, 작업을 막지는 않아요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминание о перерыве готово. Это подсказка, а не препятствие для работы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "休息提醒已准备好。这只是建议，不会阻碍你的工作。"
          }
        }
      }
    },
    "macOS could not keep the display awake (error %d); the system is still protected from idle sleep.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS could not keep the display awake (error %d); the system is still protected from idle sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no pudo mantener la pantalla activa (error %d); el sistema sigue protegido contra la suspensión por inactividad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSはディスプレイを点灯し続けられませんでした（エラー %d）。システムはアイドル時のスリープからは引き続き保護されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 디스플레이를 켜 둘 수 없었어요(오류 %d). 시스템은 여전히 유휴 절전으로부터 보호되고 있어요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось удержать дисплей включённым в macOS (ошибка %d); система всё ещё защищена от сна при простое."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 无法保持显示器常亮（错误 %d）；系统仍受空闲睡眠保护。"
          }
        }
      }
    },
    "macOS could not prevent system sleep (error %d).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS could not prevent system sleep (error %d)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no pudo impedir la suspensión del sistema (error %d)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSはシステムのスリープを防止できませんでした（エラー %d）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 시스템 절전을 막지 못했어요(오류 %d)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось предотвратить системный сон в macOS (ошибка %d)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 无法阻止系统睡眠（错误 %d）。"
          }
        }
      }
    },
    "macOS is waiting for approval in System Settings > General > Login Items.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS is waiting for approval in System Settings > General > Login Items."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS espera tu aprobación en Ajustes del Sistema > General > Elementos de inicio de sesión."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSは、システム設定 > 一般 > ログイン項目で承認を待っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 시스템 설정 > 일반 > 로그인 항목에서 승인을 기다리고 있어요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ждёт подтверждения в «Настройки системы» > «Основные» > «Объекты входа»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 正在“系统设置 > 通用 > 登录项”中等待批准。"
          }
        }
      }
    },
    "macOS rejected the sleep request (error %d).": {
