    "Adjust how %@ moves and which playful moments appear during an awake session.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust how %@ moves and which playful moments appear during an awake session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta cómo se mueve %@ y qué momentos juguetones aparecen durante una sesión activa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起きている間のセッションで、%@の動きと遊びの演出を調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨어 있는 세션 동안 %@의 움직임과 장난스러운 순간을 조정해요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настрой, как двигается %@ и какие игривые моменты появляются во время активной сессии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整 %@ 的移动方式，以及清醒会话期间出现哪些俏皮瞬间。"
          }
        }
      }
    },
    "After a confirmed session, %@ will request immediate system sleep.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a confirmed session, %@ will request immediate system sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras una sesión confirmada, %@ pedirá suspender el sistema de inmediato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認済みのセッションが終わると、%@がすぐにシステムのスリープを要求します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인된 세션이 끝나면 %@ 쪽에서 즉시 시스템 절전을 요청해요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После подтверждённой сессии %@ запросит немедленный переход системы в сон."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认的会话结束后，%@ 将请求立即让系统睡眠。"
          }
        }
      }
    },
    "After this session, your Mac will go to sleep immediately": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After this session, your Mac will go to sleep immediately"
          }
