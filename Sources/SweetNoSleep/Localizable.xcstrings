    "Configure the timer, skin, pet size, animations, breaks, agent hooks, and power settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure the timer, skin, pet size, animations, breaks, agent hooks, and power settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura el temporizador, el skin, el tamaño de la mascota, las animaciones, las pausas, los hooks de agentes y los ajustes de energía."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイマー、スキン、ペットのサイズ、アニメーション、休憩、エージェントフック、電源設定を調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이머, 스킨, 펫 크기, 애니메이션, 휴식, 에이전트 훅, 전원 설정을 조정하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настрой таймер, скин, размер питомца, анимации, перерывы, хуки агентов и параметры питания."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置计时器、皮肤、宠物大小、动画、休息提醒、智能体钩子和电源设置。"
          }
        }
      }
    },
    "Confirm immediate sleep before starting this session.": {
