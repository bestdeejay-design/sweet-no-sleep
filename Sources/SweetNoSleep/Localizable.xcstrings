            "state": "translated",
            "value": "%@ está de guardia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が勤務中です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 근무 중"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ на дежурстве"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在值班"
          }
        }
      }
    },
    "%@ is on duty and protecting this session.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is on duty and protecting this session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está de guardia y protege esta sesión."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が勤務中で、このセッションを守っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 근무 중이며 이 세션을 지키고 있어요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ на дежурстве и защищает эту сессию."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在值班，守护这次会话。"
          }
        }
      }
    },
    "%@ is ready to help": {
      "localizations": {
