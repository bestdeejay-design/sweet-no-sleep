    "Could not keep the display awake after wake (error %d); the Mac is still protected from system sleep.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not keep the display awake after wake (error %d); the Mac is still protected from system sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo mantener la pantalla activa tras despertar (error %d); el Mac sigue protegido contra la suspensión del sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復帰後にディスプレイを点灯し続けられませんでした（エラー %d）。Macはシステムのスリープから引き続き保護されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨어난 뒤 디스플레이를 켜 둘 수 없었어요(오류 %d). Mac은 여전히 시스템 절전으로부터 보호되고 있어요."
          }
