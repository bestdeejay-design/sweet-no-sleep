    "Mood weights - higher values make a mood more likely; 0 turns it off.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mood weights - higher values make a mood more likely; 0 turns it off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesos del ánimo: cuanto mayor es el valor, más probable es el ánimo; 0 lo desactiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気分の重み: 値が大きいほどその気分が出やすくなります。0でオフになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기분 가중치 - 값이 클수록 해당 기분이 자주 나타나요. 0이면 꺼요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Веса настроений — чем выше значение, тем вероятнее настроение; 0 — выключает его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "情绪权重：数值越高，该情绪越容易出现；0 表示关闭。"
          }
        }
      }
    },
