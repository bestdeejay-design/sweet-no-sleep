    "Leave this off if you do not want to use battery after a restart.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave this off if you do not want to use battery after a restart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo desactivado si no quieres gastar batería tras un reinicio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再起動後にバッテリーを使いたくない場合はオフのままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재시작 후 배터리를 쓰고 싶지 않다면 끄세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставь выключенным, если не хочешь расходовать батарею после перезагрузки."
          }
        },
        "zh-Hans": {
